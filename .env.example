# Copie para .env (que não vai para o repositório) e troque os valores.

# Gere cada senha com: openssl rand -hex 24
# (os papéis do banco aceitam só letras, números, '_' e '-', com 24+ caracteres)

# Dono do banco: usado só nas migrations
POSTGRES_PASSWORD=troque-esta-senha

# Papel que grava as cargas (CLI e worker)
TUSS_DB_SENHA_INGESTAO=troque-esta-senha

# Papel só de leitura (API)
TUSS_DB_SENHA_API=troque-esta-senha
