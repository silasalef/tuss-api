# Copie para .env (que não vai para o repositório) e troque os valores.

# Gere cada senha com: openssl rand -hex 24
# (os papéis do banco aceitam só letras, números, '_' e '-', com 24+ caracteres)

# Dono do banco: usado só nas migrations
POSTGRES_PASSWORD=troque-esta-senha

# Papel que grava as cargas (CLI e worker)
TUSS_DB_SENHA_INGESTAO=troque-esta-senha

# Papel só de leitura (API)
TUSS_DB_SENHA_API=troque-esta-senha

# SHA-256 dos tokens aceitos pela API, separados por vírgula (um por dispositivo).
# Gere com: uv run tuss token
TUSS_API_TOKENS_SHA256=

# Worker (opcional): endereço de heartbeat avisado ao fim de cada ciclo diário.
# Crie um check em https://healthchecks.io (grátis) com período de 1 dia e tolerância
# de 1 dia; sem aviso, chega e-mail. Vazio = não avisa.
TUSS_HEARTBEAT_URL=

# Recuperação das tabelas 19 e 64 (opcional): outro check, avisado a cada trecho
# publicado (~50 min) e uma vez por dia depois que ficar em dia. Período de 1 dia e
# tolerância de 1 hora. Vazio = não avisa.
TUSS_HEARTBEAT_RECUPERACAO_URL=
